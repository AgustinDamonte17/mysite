---
import { withBase } from '../lib/content';
import type { Lang } from '../lib/content';

interface Item {
  slug: string;
  title: string;
  blurb?: string;
}

interface Props {
  lang: Lang;
  items: Item[];
}

const { lang, items } = Astro.props;
---
<ul class="item-list">
  {items.map((item) => (
    <li class="item-list__item">
      <a class="item-list__title" href={withBase(`/${lang}/projects/${item.slug}/`)}>{item.title}</a>
      {item.blurb && <span class="item-list__blurb">{item.blurb}</span>}
    </li>
  ))}
</ul>
