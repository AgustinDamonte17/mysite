---
import type { Lang } from '../lib/content';
import { formatDate } from '../lib/content';

interface Props {
  date?: string;
  lang: Lang;
}

const { date, lang } = Astro.props;

function displayDate(value: string, language: Lang): string {
  // Year-only (projects): keep as-is
  if (/^\d{4}$/.test(value.trim())) return value.trim();
  return formatDate(value, language);
}

const iso =
  date && /^\d{4}-\d{2}-\d{2}/.test(String(date))
    ? String(date).slice(0, 10)
    : date
      ? String(date)
      : undefined;
---
{date && (
  <p class="post-meta">
    <time datetime={iso}>{displayDate(String(date), lang)}</time>
  </p>
)}
