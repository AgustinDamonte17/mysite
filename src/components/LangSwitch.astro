---
import type { Lang } from '../lib/content';
import { switchLangPath } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const destLang: Lang = lang === 'es' ? 'en' : 'es';
const href = switchLangPath(pathname, destLang);
const label = destLang === 'en' ? 'EN' : 'ES';
const ariaLabel = destLang === 'en' ? 'English' : 'Español';
---
<a
  class="lang-switch"
  href={href}
  hreflang={destLang}
  lang={destLang}
  aria-label={ariaLabel}
>{label}</a>
