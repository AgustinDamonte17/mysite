---
import type { Lang } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ariaToLight = lang === 'es' ? 'Cambiar a tema claro' : 'Switch to light theme';
const ariaToDark = lang === 'es' ? 'Cambiar a tema oscuro' : 'Switch to dark theme';
---
<button
  type="button"
  class="theme-switch"
  data-theme-switch
  data-aria-to-light={ariaToLight}
  data-aria-to-dark={ariaToDark}
  role="switch"
  aria-checked="true"
  aria-label={ariaToLight}
>
  <svg class="theme-switch__icon theme-switch__icon--sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="theme-switch__icon theme-switch__icon--moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
  </svg>
</button>
<script is:inline>
  (function () {
    var KEY = 'mysite-theme';
    function current() {
      var t = document.documentElement.getAttribute('data-theme');
      return t === 'light' ? 'light' : 'dark';
    }
    function sync(btn) {
      if (!btn) return;
      var theme = current();
      var aria =
        theme === 'dark'
          ? btn.getAttribute('data-aria-to-light')
          : btn.getAttribute('data-aria-to-dark');
      btn.setAttribute('aria-label', aria || '');
      btn.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
      btn.setAttribute('data-active-theme', theme);
    }
    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem(KEY, theme);
      } catch (e) {}
      document.querySelectorAll('[data-theme-switch]').forEach(sync);
      if (typeof window.__mysiteSyncFavicon === 'function') {
        window.__mysiteSyncFavicon(theme);
      }
    }
    function onClick(e) {
      var btn = e.target.closest('[data-theme-switch]');
      if (!btn) return;
      setTheme(current() === 'dark' ? 'light' : 'dark');
    }
    document.addEventListener('click', onClick);
    document.querySelectorAll('[data-theme-switch]').forEach(sync);
  })();
</script>
