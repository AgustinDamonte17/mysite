---
import { withBase, formatDate } from '../lib/content';
import type { Lang } from '../lib/content';

interface Item {
  slug: string;
  title: string;
  date?: string;
}

interface Props {
  lang: Lang;
  items: Item[];
}

const { lang, items } = Astro.props;
---
<ul class="item-list">
  {items.map((item) => (
    <li class="item-list__item">
      <a class="item-list__title" href={withBase(`/${lang}/posts/${item.slug}/`)}>{item.title}</a>
      {item.date && (
        <span class="item-list__meta">
          <time datetime={item.date}>{formatDate(item.date, lang)}</time>
        </span>
      )}
    </li>
  ))}
</ul>
