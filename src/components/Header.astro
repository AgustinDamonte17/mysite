---
import type { Lang } from '../lib/content';
import { ui, withBase } from '../lib/content';
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname;

const links = [
  { href: withBase(`/${lang}/posts/`), label: t.posts, match: `/${lang}/posts` },
  { href: withBase(`/${lang}/projects/`), label: t.projects, match: `/${lang}/projects` },
];

function isCurrent(match: string): boolean {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  let path = pathname;
  if (base && path.startsWith(base)) path = path.slice(base.length) || '/';
  return path === match || path.startsWith(`${match}/`) || path.startsWith(match);
}
---
<header class="site-header">
  <a class="site-header__brand" href={withBase(`/${lang}/`)}>{t.siteTitle}</a>
  <div class="site-header__right">
    <nav class="site-nav" aria-label={lang === 'es' ? 'Principal' : 'Primary'}>
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <LangSwitch lang={lang} />
    <ThemeSwitch lang={lang} />
  </div>
</header>
