---
import type { Lang } from '../lib/content';
import { ui, withBase, switchLangPath } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname;
const otherHref = switchLangPath(pathname, t.otherLang);

const links = [
  { href: withBase(`/${lang}/`), label: t.home, match: `/${lang}/` },
  { href: withBase(`/${lang}/posts/`), label: t.posts, match: `/${lang}/posts` },
  { href: withBase(`/${lang}/projects/`), label: t.projects, match: `/${lang}/projects` },
];

function isCurrent(match: string): boolean {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  let path = pathname;
  if (base && path.startsWith(base)) path = path.slice(base.length) || '/';
  if (match.endsWith('/') && match !== `/${lang}/`) {
    return path.startsWith(match.replace(/\/$/, '')) || path.startsWith(match);
  }
  return path === match || path === match.replace(/\/$/, '') || path === `${match}`;
}
---
<header class="site-header">
  <a class="brand" href={withBase(`/${lang}/`)}>{t.siteTitle}</a>
  <nav aria-label="Primary">
    {links.map((l) => (
      <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href={otherHref} hreflang={t.otherLang} lang={t.otherLang}>{t.langLabel}</a>
  </nav>
</header>
