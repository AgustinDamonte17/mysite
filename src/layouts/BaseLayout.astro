---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../lib/content';
import { ui } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  measure?: 'home' | 'post';
}

const { title, description, lang, measure = 'home' } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · ${t.siteTitle}` : t.siteTitle;
const shellClass = measure === 'post' ? 'site-shell site-shell--post' : 'site-shell';
const skipLabel = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
const baseRaw = import.meta.env.BASE_URL;
const base = baseRaw.endsWith('/') ? baseRaw : `${baseRaw}/`;
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t.homeIntro} />
    <meta name="theme-color" content="#1C1C1A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFAF8" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('mysite-theme');
          if (t !== 'light' && t !== 'dark') t = 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}favicon-32.png`}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}favicon-32-dark.png`}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192.png`} id="favicon-192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script is:inline define:vars={{ base }}>
      (function () {
        var light32 = base + 'favicon-32.png';
        var dark32 = base + 'favicon-32-dark.png';
        var light192 = base + 'favicon-192.png';
        var dark192 = base + 'favicon-192-dark.png';
        function ensureLink(id, rel, sizes, type) {
          var el = document.getElementById(id);
          if (el) return el;
          el = document.createElement('link');
          el.id = id;
          el.rel = rel;
          if (sizes) el.setAttribute('sizes', sizes);
          if (type) el.type = type;
          document.head.appendChild(el);
          return el;
        }
        window.__mysiteSyncFavicon = function (theme) {
          var t = theme === 'light' ? 'light' : 'dark';
          var link32 = ensureLink('favicon-theme-32', 'icon', '32x32', 'image/png');
          var link192 = ensureLink('favicon-192', 'icon', '192x192', 'image/png');
          link32.href = t === 'dark' ? dark32 : light32;
          link192.href = t === 'dark' ? dark192 : light192;
          var meta = document.querySelector('meta[name="theme-color"][data-mysite]');
          if (!meta) {
            meta = document.createElement('meta');
            meta.setAttribute('name', 'theme-color');
            meta.setAttribute('data-mysite', '1');
            document.head.appendChild(meta);
          }
          meta.setAttribute('content', t === 'dark' ? '#1C1C1A' : '#FAFAF8');
        };
        try {
          var cur = document.documentElement.getAttribute('data-theme');
          window.__mysiteSyncFavicon(cur === 'light' ? 'light' : 'dark');
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <div class="site">
      <div class={shellClass}>
        <Header lang={lang} />
        <main id="main" class="site-main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
