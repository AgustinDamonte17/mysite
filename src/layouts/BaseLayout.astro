---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../lib/content';
import { ui } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  measure?: 'home' | 'post';
}

const { title, description, lang, measure = 'home' } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · ${t.siteTitle}` : t.siteTitle;
const shellClass = measure === 'post' ? 'site-shell site-shell--post' : 'site-shell';
const skipLabel = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t.homeIntro} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('mysite-theme');
          if (t !== 'light' && t !== 'dark') t = 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <div class="site">
      <div class={shellClass}>
        <Header lang={lang} />
        <main id="main" class="site-main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
