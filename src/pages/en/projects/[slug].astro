---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjects, getProject, ui } from '../../../lib/content';

export function getStaticPaths() {
  const lang = 'en' as const;
  return getProjects(lang).map((p) => ({ params: { slug: p.slug } }));
}

const lang = 'en' as const;
const { slug } = Astro.params;
const project = getProject(lang, slug!);
if (!project) throw new Error(`Missing project ${slug}`);
const Content = project.Content as any;
---
<BaseLayout lang={lang} title={String(project.frontmatter.title)} description={String(project.frontmatter.description ?? '')}>
  <article>
    <h1>{String(project.frontmatter.title)}</h1>
    <p class="meta">{String(project.frontmatter.year ?? '')}</p>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
