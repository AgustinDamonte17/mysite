---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageTitle from '../../../components/PageTitle.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, ui } from '../../../lib/content';

const lang = 'en' as const;
const t = ui[lang];
const items = getPosts(lang).map((p) => ({
  slug: p.slug,
  title: String(p.frontmatter.title),
  date: p.frontmatter.pubDate ? String(p.frontmatter.pubDate) : undefined,
  excerpt: p.frontmatter.description ? String(p.frontmatter.description) : undefined,
}));
---
<BaseLayout lang={lang} title={t.postsHeading} measure="home">
  <PageTitle title={t.postsHeading} variant="section" />
  <PostList lang={lang} items={items} />
</BaseLayout>
