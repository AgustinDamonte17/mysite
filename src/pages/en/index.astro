---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import PostList from '../../components/PostList.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getPosts, getProjects, ui, withBase } from '../../lib/content';

const lang = 'en' as const;
const t = ui[lang];
const posts = getPosts(lang).slice(0, 5).map((p) => ({
  slug: p.slug,
  title: String(p.frontmatter.title),
  date: p.frontmatter.pubDate ? String(p.frontmatter.pubDate) : undefined,
  excerpt: p.frontmatter.description ? String(p.frontmatter.description) : undefined,
}));
const projects = getProjects(lang).slice(0, 5).map((p) => ({
  slug: p.slug,
  title: String(p.frontmatter.title),
  blurb: p.frontmatter.description ? String(p.frontmatter.description) : undefined,
}));

const leadHtml =
  "Welcome to my blog. Here I'll publish my personal and work ideas and projects. I'm a developer at Quantum América, co-founder and partner at Iris Energía. Right now I'm mainly <em>building with AI</em>.";
---
<BaseLayout lang={lang} description={t.homeIntro} measure="home">
  <PageTitle title={t.siteTitle} leadHtml={leadHtml} />

  <section class="home-section" aria-labelledby="writing-heading">
    <h2 id="writing-heading" class="home-section__heading">{t.postsHeading}</h2>
    <PostList lang={lang} items={posts} />
    <p class="home-section__more">
      <a href={withBase(`/${lang}/posts/`)}>{t.seeAll} →</a>
    </p>
  </section>

  <section class="home-section" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="home-section__heading">{t.projectsHeading}</h2>
    <ProjectList lang={lang} items={projects} />
    <p class="home-section__more">
      <a href={withBase(`/${lang}/projects/`)}>{t.seeAll} →</a>
    </p>
  </section>
</BaseLayout>
