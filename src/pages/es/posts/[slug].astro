---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostMeta from '../../../components/PostMeta.astro';
import Prose from '../../../components/Prose.astro';
import { getPosts, getPost, ui, withBase } from '../../../lib/content';

export function getStaticPaths() {
  const lang = 'es' as const;
  return getPosts(lang).map((p) => ({ params: { slug: p.slug } }));
}

const lang = 'es' as const;
const t = ui[lang];
const { slug } = Astro.params;
const post = getPost(lang, slug!);
if (!post) throw new Error(`Missing post ${slug}`);
const Content = post.Content as any;
---
<BaseLayout
  lang={lang}
  title={String(post.frontmatter.title)}
  description={String(post.frontmatter.description ?? '')}
  measure="post"
>
  <article>
    <PostMeta date={post.frontmatter.pubDate ? String(post.frontmatter.pubDate) : undefined} />
    <h1 class="post-title">{String(post.frontmatter.title)}</h1>
    <Prose>
      <Content />
    </Prose>
    <p class="post-back">
      <a href={withBase(`/${lang}/posts/`)}>← {t.postsHeading}</a>
    </p>
  </article>
</BaseLayout>
