---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getProjects, ui, withBase } from '../../lib/content';

const lang = 'es' as const;
const t = ui[lang];
const posts = getPosts(lang).slice(0, 3);
const projects = getProjects(lang).slice(0, 3);
---
<BaseLayout lang={lang} description={t.homeIntro}>
  <h1>{t.siteTitle}</h1>
  <p class="muted">{t.homeIntro}</p>

  <h2>{t.postsHeading}</h2>
  <ul class="list">
    {posts.map((p) => (
      <li>
        <a href={withBase(`/${lang}/posts/${p.slug}/`)}>{String(p.frontmatter.title)}</a>
        <div class="muted">{String(p.frontmatter.description ?? '')}</div>
      </li>
    ))}
  </ul>
  <p><a href={withBase(`/${lang}/posts/`)}>{t.postsHeading} →</a></p>

  <h2>{t.projectsHeading}</h2>
  <ul class="list">
    {projects.map((p) => (
      <li>
        <a href={withBase(`/${lang}/projects/${p.slug}/`)}>{String(p.frontmatter.title)}</a>
        <div class="muted">{String(p.frontmatter.description ?? '')}</div>
      </li>
    ))}
  </ul>
  <p><a href={withBase(`/${lang}/projects/`)}>{t.projectsHeading} →</a></p>
</BaseLayout>
