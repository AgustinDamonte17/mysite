---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import PostList from '../../components/PostList.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getPosts, getProjects, ui, withBase } from '../../lib/content';

const lang = 'es' as const;
const t = ui[lang];
const posts = getPosts(lang).slice(0, 5).map((p) => ({
  slug: p.slug,
  title: String(p.frontmatter.title),
  date: p.frontmatter.pubDate ? String(p.frontmatter.pubDate) : undefined,
}));
const projects = getProjects(lang).slice(0, 5).map((p) => ({
  slug: p.slug,
  title: String(p.frontmatter.title),
}));

const leadHtml =
  'Bienvenidos a mi blog. Acá publicaré mis ideas y proyectos personales/laborales. Soy desarrollador en Quantum América, co-fundador y socio de Iris Energía. Actualmente estoy principalmente <em>construyendo con IA</em>.';
---
<BaseLayout lang={lang} description={t.homeIntro} measure="home">
  <PageTitle title={t.siteTitle} leadHtml={leadHtml} />

  <section class="home-section" aria-labelledby="escritos-heading">
    <h2 id="escritos-heading" class="home-section__heading">{t.postsHeading}</h2>
    <PostList lang={lang} items={posts} />
    <p class="home-section__more">
      <a href={withBase(`/${lang}/posts/`)}>{t.seeAll} →</a>
    </p>
  </section>

  <section class="home-section" aria-labelledby="proyectos-heading">
    <h2 id="proyectos-heading" class="home-section__heading">{t.projectsHeading}</h2>
    <ProjectList lang={lang} items={projects} />
    <p class="home-section__more">
      <a href={withBase(`/${lang}/projects/`)}>{t.seeAll} →</a>
    </p>
  </section>
</BaseLayout>
