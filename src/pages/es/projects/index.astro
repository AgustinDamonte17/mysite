---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageTitle from '../../../components/PageTitle.astro';
import ProjectList from '../../../components/ProjectList.astro';
import { getProjects, ui } from '../../../lib/content';

const lang = 'es' as const;
const t = ui[lang];
const items = getProjects(lang).map((p) => ({
  slug: p.slug,
  title: String(p.frontmatter.title),
  blurb: p.frontmatter.description ? String(p.frontmatter.description) : undefined,
}));
---
<BaseLayout lang={lang} title={t.projectsHeading} measure="home">
  <PageTitle title={t.projectsHeading} variant="section" />
  <ProjectList lang={lang} items={items} />
</BaseLayout>
