---
import { withBase } from '../lib/content';
const target = withBase('/es/');
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <title>Redirect…</title>
  </head>
  <body>
    <p><a href={target}>Español / ES</a></p>
  </body>
</html>
